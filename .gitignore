# ============================================================
# EcoQuest — .gitignore
# ============================================================

# ─── Environment / Secret Files ─────────────────────────────
# Root level
.env
.env.*
!.env.example

# Backend secrets
backend/.env
backend/.env.*
!backend/.env.example
backend/src/main/resources/application-secret.properties

# Frontend secrets
frontend/.env
frontend/.env.*
!frontend/.env.example

# ─── Node Modules (Frontend) ────────────────────────────────
node_modules/
frontend/node_modules/

# ─── Build & Dist Output (Frontend) ─────────────────────────
dist/
build/
frontend/dist/
frontend/build/

# ─── Java & Spring Boot (Backend) ───────────────────────────
backend/target/
backend/*.class
backend/*.jar
backend/*.war
backend/*.ear
backend/*.zip
backend/*.tar.gz
backend/*.rar
backend/.mvn/
!backend/.mvn/wrapper/maven-wrapper.jar
backend/logs/

# ─── Uploaded User Files ─────────────────────────────────────
backend/uploads/

# ─── Docker / DB Data ───────────────────────────────────────
*.db
*.sqlite

# ─── Logs ───────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── OS / System Files ──────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# ─── Editor / IDE ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.iml
*.iws
.classpath
.project
.settings/

# ─── Temporary / Cache Files ────────────────────────────────
.cache/
.parcel-cache/
.vite/
*.tmp
*.temp

# ─── Coverage & Testing ─────────────────────────────────────
coverage/
.nyc_output/

# ─── Package Manager Lock Conflicts ─────────────────────────
yarn.lock
