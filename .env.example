# ============================================================
# .env.example — SAFE TO COMMIT (no real credentials)
# This file serves as documentation for environment variables.
# ============================================================

# ─── FRONTEND (Vite / React) ──────────────────────────────
# Rename to .env inside the 'frontend' folder
VITE_API_URL=http://localhost:5000

# ─── BACKEND (Spring Boot) ────────────────────────────────
# These variables can be set in your OS environment or deployment platform
# (Render, Railway, etc.) to override application.properties

# Database (MySQL)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ecoquest
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# JWT Secret — use any long random string (min 32 chars)
APP_JWT_SECRET=your_random_jwt_secret_here_min_32_chars

# Server Port
PORT=5000
